{
  "name": "driftcheck",
  "version": "0.1.0",
  "description": "PR bot that catches design drift: hard-coded colors and spacing that should be Figma tokens.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "driftcheck": "dist/cli.js"
  },
  "files": [
    "dist",
    "action.yml"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "culori": "^4.0.2",
    "postcss": "^8.5.32"
  },
  "devDependencies": {
    "@types/culori": "^4.0.1",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
